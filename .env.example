# DPMtF-WebUI Environment Variables
#
# This file documents all environment variables that the DPMtF-WebUI project reads.
# Each variable includes its purpose, default value (if applicable), and how it's resolved.
# 
# For variables not currently read as env vars by config.py (DPMTF_PROJECT_ROOT,
# DPMTF_OPENCODE_BIN), documentation shows the current .ini-based mechanism and notes
# the env var name for future use.

# Bridge directory - where the bridge flow files are stored. 
# Default: derived from project root/flows
DPMTF_BRIDGE_DIR=

# Home directory - used to resolve other paths if needed.
# Default: $HOME
DPMTF_HOME_DIR=

# Project root directory - the main project directory.
# Default: Derived from this file's location (currently .ini-based)
DPMTF_PROJECT_ROOT=

# Machine profile filename - used to determine which machine configuration to load.
# Default: machine.local.json
DPMTF_MACHINE_PROFILE=

# OpenCode binary path - location of the opencode executable.
# Default: derived from home dir (currently .ini-based)
DPMTF_OPENCODE_BIN=

# Architect session name - name of the architect session for BridgeV002.
# Default: claude_architect
DPMTF_ARCHITECT_SESSION=

# Implementer session name - name of the implementer session for BridgeV002.
# Default: claude_implementer
DPMTF_IMPLEMENTER_SESSION=

# Review session name - name of the review session for BridgeV002.
# Default: claude_review
DPMTF_REVIEW_SESSION=

# Omitted card paths - list of paths to exclude from system dashboard cards.
# Default: ["RAM", "/", "$HOME/HermesOutput", "$HOME/ComfyUI", "$HOME/ComfyUI-LTX23"]
DPMTF_OMITTED_CARD_PATHS=

# Trade inbox directory - path to the Trade Cockpit inbox.
# Default: $HOME/trade-ui/inbox/pending (currently .ini-based)
DPMTF_TRADE_INBOX=

# Model allocator-specific environment variables
# These are required for model-allocator integration and must be set correctly for local runtimes.

# Path to the llama-server binary for llama.cpp runtime
# Example: /home/svend/llama.cpp/llama-server
LLAMA_SERVER_BIN=

# Directory containing GGUF model files for llama.cpp runtime
# Example: /home/svend/models/gguf
MODEL_ROOT_GGUF=

# Directory containing SGLang model repositories for SGLang runtime
# Example: /home/svend/models/sglang
MODEL_ROOT_SGLANG=

# Path to the SGLang virtual environment
# Example: /home/svend/sglang-venv
SGLANG_VENV_PATH=

# ========================================================================
# Tuning Knobs — Optional Runtime Configuration
# ========================================================================
# These variables fine-tune the behavior of BridgeV002, the model allocator,
# and the evidence gate. They are all optional — sensible defaults apply
# when they are absent. Most installs should leave them alone.

# Seconds to allow a model server to become healthy before the lease
# is considered failed. The 120s default it replaced caused the SGLang
# adapter to kill the server it had just started. Default: 900.
DPMTF_MODEL_START_TIMEOUT=

# Seconds to wait for the GPU to release memory after a model stops,
# before loading the next. Ensures VRAM is actually free before the
# next role's model starts. Default: 120.
DPMTF_VRAM_RELEASE_TIMEOUT=

# How many times the evidence gate returns a deliverable to its author
# before escalating to the supervisor. After this many rejections the
# gate stops returning it and logs gate_escalation_required instead.
# Default: 2.
DPMTF_GATE_MAX_REJECTIONS=

# Evidence gate mode: 'block' (default) refuses invalid deliverables
# and holds the chain; 'warn' lets them through with a warning. Set
# to 'warn' to roll the gate out on a flow without blocking. Default: block.
DPMTF_EVIDENCE_GATE_MODE=

# Comma-separated path fragments the evidence gate's scope check ignores.
# Useful when you need to modify files outside a handoff's fence while
# a run is active. Leave empty for normal operation. Default: (none).
DPMTF_GATE_IGNORE_PATHS=

# Minimum share of a model that must reside in VRAM for an Ollama start
# to count as successful. Ollama silently runs the remainder on the CPU;
# setting this high ensures a model is not considered loaded if it is
# only partially in VRAM. Default: 0.9.
DPMTF_OLLAMA_MIN_GPU_FRACTION=