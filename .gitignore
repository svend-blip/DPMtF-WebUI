venv/
__pycache__/
*/__pycache__/
*.pyc
.pytest_cache/
.env

# Bridge runtime artifacts
databases/*.db
databases/*.bak*
databases/*.preh99.*
# databases/dpmtf.db was tracked until 2026-09-01 (192 revisions, 193 MB of
# history). Untracked and purged before the repo goes public: it is live
# operational state, and the i18n seed lives in scripts/db/ migrations.
.playwright-mcp/
screenshot-*.png

# Machine Profiles — local copies are git-ignored
profiles/*.json
!profiles/*.example.json

# Runtime artifacts (bridge inbox remnants, app/cron logs)
inbox/
logs/
.aider*

# Job queue checkpoints (runtime artifacts, one per completed job)
jobs/checkpoints/

# Bridge cycle state (runtime metadata, updated every dispatch)
docs/bridgeV002/current-cycle-*.json
scripts/docs/bridgeV002/current-cycle.json
# SQLite WAL sidecars — appeared when the LightWorker store enabled WAL mode
# (2026-08-07); always present while anything holds the database open.
databases/*.db-shm
databases/*.db-wal

# Runtime logs — generated, never committed. father-uvicorn.log reached 36 MB
# before this line existed.
father-uvicorn.log
*.log

# Stray SQLite files from misresolved bridge paths (all observed empty, 2026-08-29)
/bridge.db
/flows.db
scripts/bridgeV002/bridge.db
databases/bridge/
!tests/fixtures/*.log
node_modules/

# Local tool runtime (Superpowers brainstorm server state; was tracked
# until 2026-09-01 — pid files and server logs do not belong in git)
.superpowers/

# Environment variants beyond bare .env (added 2026-09-01)
.env.*
!.env.example

# Backup, editor and OS litter (added 2026-09-01 — a 50 KB .bak of a
# PLAN document slipped through before these lines existed)
*.bak
*.old
*.orig
*~
*.swp
*.pid
.claude/settings.local.json
.DS_Store
